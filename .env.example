# Ryu Engine — Root Environment Variables
# Copy to .env and fill in your values.

# Typesense
TYPESENSE_API_KEY=xyz

# OpenAI (optional, not needed if using Gemini)
OPENAI_API_KEY=

# LLM Provider (openai or gemini)
LLM_PROVIDER=gemini
OPENAI_CHAT_MODEL=gpt-4

# Gemini (free tier — get key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
